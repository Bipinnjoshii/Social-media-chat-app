{
  "buildCommand": "CI=false NODE_OPTIONS=--openssl-legacy-provider react-scripts build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://campus-connect-api-obe8.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
